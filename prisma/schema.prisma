// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                 @id @default(autoincrement())
  email               String              @unique(map: "email") @db.VarChar(255)
  name                String              @db.VarChar(100)
  gender              String              @db.VarChar(15)
  birth               DateTime            @db.Date
  address             String              @db.VarChar(255)
  detailAddress       String?             @map("detail_address") @db.VarChar(255)
  phoneNumber         String              @map("phone_number") @db.VarChar(15)
  reviews             UserStoreReview[]
  userFavorCategories UserFavorCategory[]
  ownedStores         Store[]             @relation("StoreOwner")
  missions            UserMission[]

  @@map("user")
}

model FoodCategory {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)
  userFavorCategories UserFavorCategory[]

  @@map("food_category")
}

model UserFavorCategory {
  id             Int          @id @default(autoincrement())
  user           User         @relation(fields: [userId], references: [id])
  userId         Int          @map("user_id")
  foodCategory   FoodCategory @relation(fields: [foodCategoryId], references: [id])
  foodCategoryId Int          @map("food_category_id")

  @@index([foodCategoryId], map: "f_category_id")
  @@index([userId], map: "user_id")
  @@map("user_favor_category")
}

model Store {
  id        Int               @id @default(autoincrement())
  name      String            @db.VarChar(100)
  time      String            @db.VarChar(100)
  address   String            @db.VarChar(255)
  region    String            @db.VarChar(100)
  ownerId   Int               @map("owner")
  owner     User              @relation("StoreOwner", fields: [ownerId], references: [id])
  reviews   UserStoreReview[]
  missions  Mission[]

  @@map("STORE")
}

model UserStoreReview {
  id       Int               @id @default(autoincrement())
  store    Store             @relation(fields: [storeId], references: [id])
  storeId  Int
  user     User              @relation(fields: [userId], references: [id])
  userId   Int
  content  String            @db.Text
  score    Int
  images   ReviewPicture[]

  @@map("user_store_review")
}

model Picture {
  id       Int               @id @default(autoincrement())
  url      String            @db.VarChar(255)
  reviews  ReviewPicture[]

  @@map("PICTURE")
}

model ReviewPicture {
  id        Int              @id @default(autoincrement())
  review    UserStoreReview  @relation(fields: [reviewId], references: [id])
  reviewId  Int              @map("review")
  picture   Picture          @relation(fields: [pictureId], references: [id])
  pictureId Int              @map("picture")

  @@map("REVIEWPICTURE")
}

model Mission {
  id          Int           @id @default(autoincrement())
  store       Store         @relation(fields: [storeId], references: [id])
  storeId     Int           @map("store")
  content     String        @db.VarChar(255)
  point       Int
  assignments UserMission[]

  @@map("MISSION")
}

model UserMission {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int      @map("user")
  mission    Mission  @relation(fields: [missionId], references: [id])
  missionId  Int      @map("mission")
  isProgress Boolean  @map("isProgress") @db.TinyInt
  startAt    DateTime? @map("start_at")

  @@map("USER-MISSION")
}
